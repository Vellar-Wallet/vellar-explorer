{
  "name": "vellar-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "Public x402 payment explorer for Stellar — watches the network from the outside, browsable across any facilitator.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate-heuristic": "tsx scripts/validate-heuristic.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@stellar/stellar-sdk": "^16.0.1",
    "fastify": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
